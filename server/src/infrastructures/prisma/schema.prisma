generator client {
  provider     = "prisma-client"
  output       = "./common"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Every user-owned row carries `userId`: the N-PAX User ID that connected,
// lowercased (N-PAX logins are Active Directory names, which ignore case).

/// One block of logged work. Times are minutes since local midnight (0–1440).
model LogEntry {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  /// Local calendar day, "YYYY-MM-DD".
  date             String
  startMinutes     Int       @map("start_minutes")
  endMinutes       Int       @map("end_minutes")
  description      String
  /// N-PAX Work Activity code (see WORK_ACTIVITIES); null until picked.
  workActivityCode String?   @map("work_activity_code")
  /// N-PAX Job code (e.g. "CL00-00003-001"); null until picked.
  jobCode          String?   @map("job_code")
  /// Set once the entry has been saved to N-PAX.
  syncedAt         DateTime? @map("synced_at")
  /// Changed after a sync had saved it to N-PAX; cleared when a sync saves it again.
  editedSinceSync  Boolean   @default(false) @map("edited_since_sync")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("log_entries")
}

/// One row per user: when the server uploads that user's entries to N-PAX.
model SyncSchedule {
  userId               String   @id @map("user_id")
  enabled              Boolean  @default(false)
  /// 'daily' | 'interval' | 'monthly' | 'manual'
  mode                 String   @default("daily")
  dailyAtMinutes       Int      @default(1080) @map("daily_at_minutes")
  intervalHours        Int      @default(2) @map("interval_hours")
  windowStartMinutes   Int      @default(480) @map("window_start_minutes")
  windowEndMinutes     Int      @default(1080) @map("window_end_minutes")
  /// Date#getDay() numbering, 0 = Sunday.
  days                 Int[]    @default([1, 2, 3, 4, 5])
  monthlyDaysBeforeEnd Int      @default(0) @map("monthly_days_before_end")
  monthlyWeekdaysOnly  Boolean  @default(true) @map("monthly_weekdays_only")
  targetUrl            String   @default("https://workflow.n-pax.com/index.aspx") @map("target_url")
  retryAttempts        Int      @default(3) @map("retry_attempts")
  skipEmptyDays        Boolean  @default(true) @map("skip_empty_days")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("sync_schedule")
}

model SyncRun {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// 'scheduled' | 'manual'
  trigger    String
  /// 'running' | 'success' | 'failed' | 'skipped'
  status     String
  entryCount Int       @default(0) @map("entry_count")
  minutes    Int       @default(0)
  message    String?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

/// One row per connected user: the N-PAX login saved by Connect, so the server can log
/// in again after a restart. The password is AES-256-GCM encrypted, never stored plain.
/// Disconnecting deletes the row; the user's entries, schedule and runs stay.
model NpaxCredential {
  userId            String   @id @map("user_id")
  /// The User ID as typed at Connect, used to sign in to N-PAX.
  loginId           String   @map("login_id")
  /// "iv:authTag:ciphertext", base64 parts; see EncryptionService.
  passwordEncrypted String   @map("password_encrypted")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("npax_credentials")
}

/// A desktop signed in through Connect. The desktop sends the raw token as a Bearer
/// token; only its SHA-256 hash is stored. Disconnect deletes the user's sessions.
model UserSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

/// One row per user: when to email them a reminder to log their hours, and the
/// address it goes to. The address is read once from N-PAX (Personnel › Present
/// Address Update) and kept here so the site isn't read again on every send.
model ReminderSetting {
  userId         String    @id @map("user_id")
  enabled        Boolean   @default(false)
  /// Minutes since local midnight; 1020 = 5:00 PM.
  atMinutes      Int       @default(1020) @map("at_minutes")
  /// Date#getDay() numbering, 0 = Sunday.
  days           Int[]     @default([1, 2, 3, 4, 5])
  /// The Email shown on N-PAX's Present Address Update; null until read.
  email          String?
  emailFetchedAt DateTime? @map("email_fetched_at")
  /// "YYYY-MM-DD" of the last reminder sent, so a day is never reminded twice.
  lastSentDate   String?   @map("last_sent_date")
  /// Also email on each of `days` when hours are missing, besides the month-end report.
  nudge          Boolean   @default(false)
  /// "YYYY-MM-DD" of the last day-of reminder sent.
  lastNudgeDate  String?   @map("last_nudge_date")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("reminder_settings")
}

/// One row per user who has picked a typing-test leaderboard name.
model TypingPlayer {
  userId    String        @id @map("user_id")
  /// Shown on the leaderboard, 1–20 characters.
  name      String
  /// The name trimmed, lowercased and single-spaced: two players can't share a name,
  /// whatever its case or spacing.
  nameKey   String        @unique @map("name_key")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  scores       TypingScore[]
  /// The same name heads the Tetris leaderboard: one name for both games.
  tetrisScores TetrisScore[]
  /// And the Aim lab leaderboard.
  aimLabScores AimLabScore[]

  @@map("typing_players")
}

/// A user's best typing-test run for one exact setup; replaced only when beaten.
model TypingScore {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  /// The test setup, e.g. "time-30" or "words-25-punctuation" (the desktop's bestKey).
  setup     String
  wpm       Float
  /// Correct keystrokes out of all keystrokes, 0–100.
  accuracy  Float
  updatedAt DateTime     @updatedAt @map("updated_at")
  player    TypingPlayer @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, setup])
  @@index([setup, wpm])
  @@map("typing_scores")
}

/// A user's best Tetris game for one start level; replaced only when beaten.
model TetrisScore {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  /// The start level, e.g. "level-15" (the desktop's tetrisBestKey).
  setup     String
  score     Int
  lines     Int
  /// The level the game ended on.
  level     Int
  updatedAt DateTime     @updatedAt @map("updated_at")
  player    TypingPlayer @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, setup])
  @@index([setup, score])
  @@map("tetris_scores")
}

/// A user's best Aim lab session for one mode; replaced only when beaten.
model AimLabScore {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  /// The mode, e.g. "bot-reflex" or "dot-tracking" (the Unity build's AimLabBridge key).
  setup      String
  /// Kills or hits for most modes; seconds to 50 kills for "bot-time-attack", where lower wins.
  score      Float
  /// Hits out of shots fired, 0–100.
  accuracy   Float
  shotsFired Int          @map("shots_fired")
  shotsHit   Int          @map("shots_hit")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  player     TypingPlayer @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, setup])
  @@index([setup, score])
  @@map("aim_lab_scores")
}

/// A user's Tetris preferences, so they follow the account to any machine.
/// Aim lab settings: each user's mouse sensitivity, so it follows the account to any machine.
model AimLabSetting {
  userId      String   @id @map("user_id")
  /// On Valorant's scale (1 = 0.07° of turn per mouse count), 0.01–5.
  sensitivity Float
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("aim_lab_settings")
}

model TetrisSetting {
  userId    String   @id @map("user_id")
  /// Key bindings per action, as the desktop's TetrisKeyBindings: { "left": ["ArrowLeft"], ... }.
  keys      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tetris_settings")
}

/// A user's Run yourself preferences, so they follow the account to any machine.
model RunSetting {
  userId    String   @id @map("user_id")
  /// Key bindings per game, then per control, as the desktop's RunBindings:
  /// { "speed-run": { "jump": [" ", "ArrowUp"], ... }, "pass-or-fall": { "left": ["ArrowLeft"], ... } }.
  keys      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("run_settings")
}

/// A user's Pass or fall progress: the furthest door unlocked, where Continue resumes, and their
/// best finished run for the leaderboard (named by the typing test's TypingPlayer, looked up by user).
model PassOrFallProgress {
  userId      String   @id @map("user_id")
  /// The room Continue resumes at, 0-based (the desktop's ROOM_LEVELS index); only ever moves forward.
  level       Int
  /// Points and seconds banked on the way to that room; Continue carries them on.
  points      Int
  seconds     Float
  /// The best finished run by points; null until a run ends.
  bestPoints  Int?     @map("best_points")
  /// Levels that run cleared, and how long it took.
  bestLevels  Int?     @map("best_levels")
  bestSeconds Float?   @map("best_seconds")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([bestPoints])
  @@map("pass_or_fall_progress")
}

/// Run yourself's Speed run: each user's best finished run to the line (a knockout doesn't count).
model SpeedRunBest {
  userId    String   @id @map("user_id")
  /// Ranked by points, then the further run, then the faster one.
  points    Int
  /// How far it got: the full course (1000) when it crossed the finish line, less when knocked out.
  metres    Int      @default(1000)
  /// Seconds run: to the finish line, or until the knockout.
  seconds   Float
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([points])
  @@map("speed_run_best")
}
