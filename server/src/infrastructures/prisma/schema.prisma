generator client {
  provider     = "prisma-client"
  output       = "./common"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Every user-owned row carries `userId`: the N-PAX User ID that connected,
// lowercased (N-PAX logins are Active Directory names, which ignore case).

/// One block of logged work. Times are minutes since local midnight (0–1440).
model LogEntry {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  /// Local calendar day, "YYYY-MM-DD".
  date             String
  startMinutes     Int       @map("start_minutes")
  endMinutes       Int       @map("end_minutes")
  description      String
  /// N-PAX Work Activity code (see WORK_ACTIVITIES); null until picked.
  workActivityCode String?   @map("work_activity_code")
  /// N-PAX Job code (e.g. "CL00-00003-001"); null until picked.
  jobCode          String?   @map("job_code")
  /// Set once the entry has been saved to N-PAX.
  syncedAt         DateTime? @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("log_entries")
}

/// One row per user: when the server uploads that user's entries to N-PAX.
model SyncSchedule {
  userId               String   @id @map("user_id")
  enabled              Boolean  @default(false)
  /// 'daily' | 'interval' | 'monthly' | 'manual'
  mode                 String   @default("daily")
  dailyAtMinutes       Int      @default(1080) @map("daily_at_minutes")
  intervalHours        Int      @default(2) @map("interval_hours")
  windowStartMinutes   Int      @default(480) @map("window_start_minutes")
  windowEndMinutes     Int      @default(1080) @map("window_end_minutes")
  /// Date#getDay() numbering, 0 = Sunday.
  days                 Int[]    @default([1, 2, 3, 4, 5])
  monthlyDaysBeforeEnd Int      @default(0) @map("monthly_days_before_end")
  monthlyWeekdaysOnly  Boolean  @default(true) @map("monthly_weekdays_only")
  targetUrl            String   @default("https://workflow.n-pax.com/index.aspx") @map("target_url")
  retryAttempts        Int      @default(3) @map("retry_attempts")
  skipEmptyDays        Boolean  @default(true) @map("skip_empty_days")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("sync_schedule")
}

model SyncRun {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// 'scheduled' | 'manual'
  trigger    String
  /// 'running' | 'success' | 'failed' | 'skipped'
  status     String
  entryCount Int       @default(0) @map("entry_count")
  minutes    Int       @default(0)
  message    String?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

/// One row per connected user: the N-PAX login saved by Connect, so the server can log
/// in again after a restart. The password is AES-256-GCM encrypted, never stored plain.
/// Disconnecting deletes the row; the user's entries, schedule and runs stay.
model NpaxCredential {
  userId            String   @id @map("user_id")
  /// The User ID as typed at Connect, used to sign in to N-PAX.
  loginId           String   @map("login_id")
  /// "iv:authTag:ciphertext", base64 parts; see EncryptionService.
  passwordEncrypted String   @map("password_encrypted")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("npax_credentials")
}

/// A desktop signed in through Connect. The desktop sends the raw token as a Bearer
/// token; only its SHA-256 hash is stored. Disconnect deletes the user's sessions.
model UserSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

/// One row per user: when to email them a reminder to log their hours, and the
/// address it goes to. The address is read once from N-PAX (Personnel › Present
/// Address Update) and kept here so the site isn't read again on every send.
model ReminderSetting {
  userId         String    @id @map("user_id")
  enabled        Boolean   @default(false)
  /// Minutes since local midnight; 1020 = 5:00 PM.
  atMinutes      Int       @default(1020) @map("at_minutes")
  /// Date#getDay() numbering, 0 = Sunday.
  days           Int[]     @default([1, 2, 3, 4, 5])
  /// The Email shown on N-PAX's Present Address Update; null until read.
  email          String?
  emailFetchedAt DateTime? @map("email_fetched_at")
  /// "YYYY-MM-DD" of the last reminder sent, so a day is never reminded twice.
  lastSentDate   String?   @map("last_sent_date")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("reminder_settings")
}
